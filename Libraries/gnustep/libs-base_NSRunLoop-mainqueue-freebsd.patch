+/* On FreeBSD the main-queue wakeup handle depends on which libdispatch is
+ * loaded.  The swift-corelibs build hands back a kqueue holding one
+ * EVFILT_USER knote (readable until kevent()ed); a pipe-based build may hand
+ * back a packed (rfd<<32|wfd) pair.  Use the private header declaration
+ * when available; older public-only headers need the widest return type. */
+#ifndef DISPATCH_CF_SPI_VERSION
+extern uint64_t _dispatch_get_main_queue_handle_4CF(void);
+#endif
+
+/* fstat(2) reports a kqueue as S_IFIFO, so a pipe and a kqueue cannot be
+ * told apart that way; kevent(2) on anything but a kqueue fails (EINVAL). */
+static BOOL
+GSFreeBSDIsKqueue(int fd)
+{
+  struct kevent		ev;
+  struct timespec	ts = { 0, 0 };
 
+  return (kevent(fd, NULL, 0, &ev, 1, &ts) == -1) ? NO : YES;
+}
+
+static int
+GSFreeBSDMainQueueReadFD(void)
+{
+  uint64_t	h = _dispatch_get_main_queue_handle_4CF();
+  int		hi = (int)(h >> 32);
+  int		lo = (int)(h & 0xffffffffULL);
+
+  if (hi > 0 && hi != lo && GSFreeBSDIsKqueue(hi) == NO)
+    {
+      return hi;	/* packed (rfd<<32|wfd) pipe handle: poll the read end */
+    }
+  return lo;		/* kqueue (or a plain single descriptor) */
+}
+#endif
+
 @interface GSMainQueueDrainer : NSObject <RunLoopEvents>
 + (void*) mainQueueFileDescriptor;
 @end
