[Unit]
Description=ArchSTEP Login Panel

# Dependencies to GNUstep services
Requires=gdnc.service gdnc-local.service

# replaces the getty
Conflicts=getty@tty1.service
After=getty@tty1.service
After=gdnc.service gdnc-local.service

After=rc-local.service systemd-user-sessions.service

[Service]
ExecStart=/usr/NextSpace/Apps/Login.app/Login
ExecStartPost=-/bin/bash -c "TERM=linux /usr/bin/clear > /dev/tty1"
KillMode=process
KillSignal=SIGQUIT
Restart=on-success
RestartSec=2s
IgnoreSIGPIPE=no
StandardOutput=journal
StandardError=inherit
SyslogLevel=info

[Install]
Alias=display-manager.service
